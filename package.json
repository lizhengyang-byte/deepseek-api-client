{
  "name": "deepseek-api-client",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "非官方 DeepSeek 客户端：官方账号登录、API 计费、官方导出数据导入与续聊",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:patch": "node scripts/android-patch.mjs",
    "android:icons": "node scripts/android-icons.mjs",
    "android:apk": "npm run android:sync && npm run android:patch && node scripts/android-icons.mjs && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "dexie": "^4.0.8",
    "highlight.js": "^11.10.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
